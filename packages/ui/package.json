{
  "name": "@modx/ui",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "author": "Saidmashhud Habibzoda",
  "repository": {
    "type": "git",
    "url": "https://github.com/saidmashhud/modx-ui"
  },
  "description": "mx-* web components on Lit 3: buttons, forms, pickers, overlays, navigation, display, markdown.",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*.js": "./src/*.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-packages.mjs ui",
    "prepublishOnly": "node ../../scripts/guard-publish.mjs"
  },
  "sideEffects": [
    "./src/index.ts",
    "./src/button.ts",
    "./src/display.ts",
    "./src/form.ts",
    "./src/icons.ts",
    "./src/illustration.ts",
    "./src/markdown.ts",
    "./src/nav.ts",
    "./src/overlay.ts",
    "./src/pickers.ts"
  ],
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "lit": "^3.3.3"
  }
}
